{
  "info": {
    "name": "ZingBite Enterprise Food Delivery Platform API",
    "description": "Complete Postman Collection covering Auth, RBAC, Restaurants, Foods, Orders, Payments, and all 6 Mandatory Advanced Backend Tasks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "token", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "restaurantId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication & RBAC",
      "item": [
        {
          "name": "Login (Customer / Admin / Restaurant / Rider)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@zingbite.com\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Priya Nair\",\n  \"email\": \"priya@zingbite.com\",\n  \"password\": \"Customer@123\",\n  \"phone\": \"9845099887\",\n  \"role\": \"customer\"\n}"
            }
          }
        },
        {
          "name": "Get Current User (/auth/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Task 1: Fraud Detection & Order Validation",
      "item": [
        {
          "name": "Get Flagged Suspicious Orders (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/admin/fraud/orders"
          }
        },
        {
          "name": "Get Fraud Order Detail (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/admin/fraud/orders/{{orderId}}"
          }
        },
        {
          "name": "Approve Flagged Order (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/fraud/orders/{{orderId}}/approve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Verified legitimate customer via phone call\"\n}"
            }
          }
        },
        {
          "name": "Reject Suspicious Order (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/fraud/orders/{{orderId}}/reject",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"High risk velocity & coupon abuse\"\n}"
            }
          }
        },
        {
          "name": "Restrict User Account (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/fraud/users/{{userId}}/restrict",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isRestricted\": true,\n  \"reason\": \"Abnormal cancellation & coupon velocity\",\n  \"durationHours\": 48\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Task 2: Advanced Restaurant Search & Filtering",
      "item": [
        {
          "name": "Search by Cuisine, Rating & Max Delivery Time",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/search?cuisine=Biryani&rating=4&maxDeliveryTime=30"
          }
        },
        {
          "name": "Fuzzy Typo-Tolerant Search ('birynai')",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/search?q=birynai"
          }
        },
        {
          "name": "Filter Vegetarian & Price Range",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/search?vegetarian=true&minPrice=100&maxPrice=500&sortBy=rating"
          }
        },
        {
          "name": "Admin Create Restaurant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/restaurants/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Spice Terrace Kitchen\",\n  \"description\": \"Coastal & North Indian specialties\",\n  \"cuisines\": [\"North Indian\", \"Seafood\"],\n  \"avgPriceForTwo\": 450,\n  \"deliveryTimeMinutes\": 26\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. Task 3: Dynamic Surge Pricing for Delivery Fees",
      "item": [
        {
          "name": "Calculate Dynamic Delivery Fee",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/orders/calculate-delivery-fee",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"customerCoordinates\": [77.6408, 12.9784],\n  \"subtotal\": 480,\n  \"simulatedHour\": 13\n}"
            }
          }
        },
        {
          "name": "Get Surge Pricing Settings (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/admin/surge-settings"
          }
        },
        {
          "name": "Update Surge Pricing Settings (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/surge-settings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isEnabled\": true,\n  \"baseDeliveryFee\": 30,\n  \"perKmRate\": 8\n}"
            }
          }
        }
      ]
    },
    {
      "name": "5. Task 4: Smart Delivery Partner Assignment",
      "item": [
        {
          "name": "Set Delivery Partner Status & 2dsphere Location",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/delivery/set-status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isOnline\": true,\n  \"isAvailable\": true,\n  \"lat\": 12.9716,\n  \"lng\": 77.6197\n}"
            }
          }
        },
        {
          "name": "Get Nearby Eligible Delivery Partners ($near)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/delivery/available?lat=12.9716&lng=77.6197"
          }
        },
        {
          "name": "Get Delivery Assignments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/delivery/assignments"
          }
        },
        {
          "name": "Admin Reassign Delivery Partner",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/delivery/reassign/{{orderId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Manual dispatch optimization\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "6. Task 5: Real-Time Order Status & Notifications",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/orders/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"items\": [{ \"foodId\": \"<foodId>\", \"quantity\": 2 }],\n  \"paymentMethod\": \"ONLINE\"\n}"
            }
          }
        },
        {
          "name": "Update Order Status (Restaurant / Delivery / Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/orders/update-status/{{orderId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Restaurant Accepted\"\n}"
            }
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/orders/cancel/{{orderId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Ordered by mistake\"\n}"
            }
          }
        },
        {
          "name": "Get Order History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/orders/history"
          }
        }
      ]
    },
    {
      "name": "7. Task 6: Dynamic Restaurant Recommendations",
      "item": [
        {
          "name": "Get Personalized Recommendations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/restaurants/recommendations"
          }
        },
        {
          "name": "Get Recommendations by User ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/restaurants/recommendations/{{userId}}"
          }
        }
      ]
    }
  ]
}

